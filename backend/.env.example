# Example backend settings; copy to .env and add your own Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGIN=http://localhost:5173
MEMORY_MAX_TURNS=5
MEMORY_SUMMARY_MAX_MESSAGES=20
MEMORY_SUMMARY_MAX_TOKENS=8000
# Enable cross-app conversation API with a backend-to-backend secret.
CONVERSATION_API_KEY=
