{
  "openapi": "3.1.0",
  "info": {
    "title": "記帳小幫手 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Dashboard",
        "operationId": "dashboard_api_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses": {
      "post": {
        "summary": "Create Expenses",
        "operationId": "create_expenses_api_expenses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseSubmissionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses/{expense_id}": {
      "delete": {
        "summary": "Delete Expense",
        "operationId": "delete_expense_api_expenses__expense_id__delete",
        "parameters": [
          {
            "name": "expense_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expense Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteExpenseResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversation_id}/context": {
      "get": {
        "summary": "Get Conversation Context",
        "operationId": "get_conversation_context_api_conversations__conversation_id__context_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          },
          {
            "name": "X-Source-App",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "X-Source-App"
            }
          },
          {
            "name": "X-Conversation-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Conversation-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationContextResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversation_id}/turns": {
      "post": {
        "summary": "Append Conversation Turn",
        "operationId": "append_conversation_turn_api_conversations__conversation_id__turns_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          },
          {
            "name": "X-Source-App",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "X-Source-App"
            }
          },
          {
            "name": "X-Conversation-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Conversation-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationTurn"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiErrorResponse"
      },
      "ConversationContextResponse": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "messages"
        ],
        "title": "ConversationContextResponse"
      },
      "ConversationMessage": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "source_app_id": {
            "type": "string",
            "title": "Source App Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "source_app_id",
          "role",
          "content",
          "created_at"
        ],
        "title": "ConversationMessage"
      },
      "ConversationTurn": {
        "properties": {
          "user_message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "User Message"
          },
          "assistant_message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Assistant Message"
          }
        },
        "type": "object",
        "required": [
          "user_message",
          "assistant_message"
        ],
        "title": "ConversationTurn",
        "description": "A completed turn submitted by a trusted app backend."
      },
      "Dashboard": {
        "properties": {
          "today": {
            "type": "number",
            "title": "Today"
          },
          "this_month": {
            "type": "number",
            "title": "This Month"
          },
          "big_boss": {
            "type": "number",
            "title": "Big Boss"
          },
          "daily": {
            "type": "number",
            "title": "Daily"
          },
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ExpenseRecord"
            },
            "type": "array",
            "title": "Expenses"
          }
        },
        "type": "object",
        "required": [
          "today",
          "this_month",
          "big_boss",
          "daily",
          "expenses"
        ],
        "title": "Dashboard"
      },
      "DeleteExpenseResponse": {
        "properties": {
          "deleted": {
            "type": "integer",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "DeleteExpenseResponse"
      },
      "ExpenseCategory": {
        "type": "string",
        "enum": [
          "大魔王支出",
          "日常支出"
        ],
        "title": "ExpenseCategory"
      },
      "ExpenseInput": {
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Item"
          },
          "amount": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "spent_on": {
            "type": "string",
            "format": "date",
            "title": "Spent On"
          }
        },
        "type": "object",
        "required": [
          "item",
          "amount",
          "spent_on"
        ],
        "title": "ExpenseInput"
      },
      "ExpenseRecord": {
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Item"
          },
          "amount": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "spent_on": {
            "type": "string",
            "format": "date",
            "title": "Spent On"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "category": {
            "$ref": "#/components/schemas/ExpenseCategory"
          },
          "comment": {
            "type": "string",
            "title": "Comment"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "item",
          "amount",
          "spent_on",
          "id",
          "category",
          "comment",
          "created_at"
        ],
        "title": "ExpenseRecord"
      },
      "ExpenseSubmissionResponse": {
        "properties": {
          "saved": {
            "type": "integer",
            "title": "Saved"
          },
          "ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Ids"
          },
          "advice": {
            "type": "string",
            "title": "Advice"
          },
          "ai_available": {
            "type": "boolean",
            "title": "Ai Available"
          },
          "ai_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Error"
          }
        },
        "type": "object",
        "required": [
          "saved",
          "ids",
          "advice",
          "ai_available"
        ],
        "title": "ExpenseSubmissionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "HealthResponse"
      },
      "Submission": {
        "properties": {
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ExpenseInput"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Expenses"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "expenses",
          "comment"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
